# ═══════════════════════════════════════════════════════════════
# Quil - Crime Pump Detection & Trading Bot
# Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Blockchain Explorers ─────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_key
# Optional legacy/community endpoint fallback; use ETHERSCAN_API_KEY for full Ethereum + BSC coverage.
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=your_solscan_key
# Optional additional Solscan keys; tried in order if an earlier key is unauthorized, rate limited, or unavailable.
SOLSCAN_API_KEY_2=
SOLSCAN_API_KEY_3=
# Solana holder/supply providers: primary Helius + up to two additional keys, then Shyft, QuickNode, Alchemy. Helius keys on one plan may share quota.
# Full-account providers are accepted only when the fetched balances reconcile to total mint supply.
HELIUS_API_KEY=
HELIUS_API_KEY_2=
HELIUS_API_KEY_3=
SHYFT_API_KEY=
# QuickNode: paste the full Solana mainnet endpoint URL from your QuickNode dashboard.
QUICKNODE_SOLANA_RPC_URL=
# Alchemy: API key for its Solana mainnet RPC (uses paginated getProgramAccountsV2).
ALCHEMY_SOLANA_API_KEY=

# ── Market Data ──────────────────────────────────────────────
COINGLASS_API_KEY=your_coinglass_key
COINGECKO_API_KEY=your_coingecko_key

# ── Exchange API Keys (for live trading via CCXT) ────────────
# Only needed if TRADING_MODE=live
BINANCE_API_KEY=
BINANCE_SECRET=
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
GATE_API_KEY=
GATE_SECRET=
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── Social ───────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (Supabase) — recommended for persistent data
# Supabase → Connect → Session Pooler (port 5432) → copy the URI shown
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres

# SQLite fallback (local development only; hosted filesystem may be lost on restart/redeploy)
# DATABASE_URL=sqlite+aiosqlite:///./quil.db

# ── Trading Mode ─────────────────────────────────────────────
# "paper" = simulated trades (default, safe)
# "live"  = real money on exchanges (requires API keys above)
TRADING_MODE=paper

# ── Bot Settings ─────────────────────────────────────────────
SCAN_INTERVAL_SECONDS=30
ALERT_COOLDOWN_MINUTES=15
MIN_CONFIDENCE_ALERT=0.5
MIN_LAYERS_CONFIRMED=2
# Autonomous single-layer Watch alerts can be noisy; confirmed alerts remain enabled.
# Manual /scan and /trade analyses can still return Watch results when this is false.
AUTONOMOUS_WATCH_ALERTS=false
